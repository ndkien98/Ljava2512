<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context
        http://www.springframework.org/schema/context/spring-context.xsd
        http://www.springframework.org/schema/mvc
        http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- Enable components scanning for Controllers ONLY,
     tức là tất cả các class trong package vn.edu.t3h.controller sẽ được Spring tự động phát hiện và đăng ký làm Bean,
     có thể mở rộng package ra bằng vn.edu.t3h -> tất cả các class trong package vn.edu.t3h sẽ được phát hiện, và tạo bean thay vì chỉ trong
     package controller
     -->
    <context:component-scan base-package="vn.edu.t3h.controller" />

    <!-- Enables the Spring MVC @Controller programming model -->
    <mvc:annotation-driven />

    <!-- Handle static resources -->
    <mvc:resources mapping="/resources/**" location="/resources/" />

    <!-- View Resolver -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/" />
        <property name="suffix" value=".jsp" />
    </bean>

    <!-- Load properties file -->
    <context:property-placeholder location="classpath:application.properties" />

    <!-- Configure the DataSource using HikariCP -->
    <bean id="dataSource" class="com.zaxxer.hikari.HikariDataSource" destroy-method="close">
        <property name="driverClassName" value="${db.driver}" />
        <property name="jdbcUrl" value="${db.url}" />
        <property name="username" value="${db.username}" />
        <property name="password" value="${db.password}" />
        <property name="maximumPoolSize" value="${hikari.maximumPoolSize}" />
        <property name="minimumIdle" value="${hikari.minimumIdle}" />
        <property name="idleTimeout" value="${hikari.idleTimeout}" />
        <property name="connectionTimeout" value="${hikari.connectionTimeout}" />
        <property name="maxLifetime" value="${hikari.maxLifetime}" />
    </bean>

    <!-- Configure JdbcTemplate -->
    <bean id="jdbcTemplate" class="org.springframework.jdbc.core.JdbcTemplate">
        <property name="dataSource" ref="dataSource" />
    </bean>

    <!-- Define Beans Manually -->
    <bean id="productRepository" class="vn.edu.t3h.repository.ProductRepository">
        <property name="jdbcTemplate" ref="jdbcTemplate" />
    </bean>

    <bean id="productService" class="vn.edu.t3h.service.ProductService">
        <property name="productRepository" ref="productRepository" />
    </bean>


</beans>
