# .gitignore for Java Spring Boot Microservices and Node.js Frontend

# Maven/Gradle build output
**/target/
**/build/

# Logs
**/*.log

# IDE files
**/.idea/
**/.vscode/
**/*.iml

# OS generated files
**/.DS_Store
**/Thumbs.db

# Node.js dependencies
frontend/node_modules/

# Environment and config files
**/.env
**/.env.*
**/application-local.yml
**/application-dev.yml
**/application-prod.yml
config-repo/application.yml

# Compiled class files
**/*.class

# Uploads, keys, and sensitive data
**/uploads/
**/key/

# Misc
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Ignore generated sources
**/generated-sources/
**/generated-test-sources/

# Ignore test classes
**/test-classes/

# Ignore maven status
**/maven-status/
**/maven-archiver/

# Ignore files in docs that are not source
!docs/*.md
!docs/Nội nội dung bài học
